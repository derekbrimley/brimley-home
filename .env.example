# Supabase (server-only; no client build in this project)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bearer tokens accepted by the API, as name:secret pairs. "tablet" is the DC-1,
# "zo" is the lunch-menu script. Generate with: openssl rand -hex 24
HOME_API_TOKENS=tablet:replace-me,zo:replace-me

# Google service account (JSON, one line) with the Sheets and Calendar scopes.
# Share the family calendar and the master sheet with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=family@group.calendar.google.com
GOOGLE_SHEET_ID=

# Family members, as "Name:keyword,keyword" pairs. Keywords match calendar
# titles ("Sylvie: piano", "piano (sylvie)") to assign a person.
FAMILY_MEMBERS=Sylvie:sylvie,Dad:dad,derek,Mom:mom

# Weather: latitude,longitude and the timezone the household lives in
HOME_LATLON=40.76,-111.89
HOME_TZ=America/Denver

# TMDB (free API key from themoviedb.org) for posters and streaming availability
TMDB_API_KEY=
# Country code for streaming availability
TMDB_REGION=US

# Crate (music). The household token is added to Crate in milestone 3.
CRATE_API_URL=https://crate.yourdomain.com
CRATE_TOKEN=
# Which Spotify Connect device is the kitchen (substring of its name)
KITCHEN_DEVICE_NAME=DC-1

# Vercel cron protection (Vercel sends this as a bearer token to cron routes)
CRON_SECRET=
